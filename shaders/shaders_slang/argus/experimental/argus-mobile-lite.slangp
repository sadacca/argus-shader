# RETIRED / EXPERIMENTAL — not a recommended preset. Moved here (docs/
# backlog.md, P-3) because it measures worse than nearest-neighbour on
# real smooth content (docs/requirements.md §4, tools/gold_eval/report.md)
# and real RetroArch testing found it "slow and nearly unplayable... no
# benefit whatsoever to smoothing" next to xBRZ. Kept only as a named
# baseline the eval harness (tools/gold_eval/, tools/render_harness/)
# scores future candidates against — do not install this for normal use.
# See docs/backlog-status.md for the code-level diagnosis of why.
#
# Original T-013/T-020 history: root .slangp skeleton for the mobile-lite
# tier (FR3: 1 pass, 1 output-resolution pass), driving the fused
# classifier + reconstruction pass in shaders/mobile-lite.slang.

shaders = 1

shader0 = shaders/mobile-lite.slang
filter_linear0 = false
wrap_mode0 = clamp_to_edge
scale_type0 = viewport
# scale0 is a no-op at real runtime (scale_type0=viewport means RetroArch
# always renders to the actual output viewport, whatever that is). It's set
# to 4.0, not the spec-conventional 1.0, because tools/render_harness's
# offline harness has no notion of a real viewport and reads this field
# literally as its test output-size multiplier (render_pass.py, `scale`
# arg) — at the previous 1.0, every golden regenerated bit-identical to the
# old T-013 passthrough, silently testing nothing of T-020's reconstruction
# logic (edge-directed blending is a no-op at 1:1 by construction: the
# sub-pixel offset within a source texel is exactly zero when output
# resolution equals source resolution). 4.0 matches the middle of the
# realistic 2x-6x range T-018's report.md characterizes; see
# tools/fusion/report.md.
scale0 = 4.0
